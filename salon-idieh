<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Salon Idieh Salon Suites | Ellenwood, GA</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz@0,9..144;1,9..144&family=Inter:wght@300;400;500;600&display=swap');

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background-color: #FAF7F1;
    color: #211F1C;
    line-height: 1.65;
    overflow-x: hidden;
  }

  h1, h2, h3 {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
  }

  a { text-decoration: none; color: inherit; }

  /* ===== NAV ===== */
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 6%;
    background: rgba(250, 247, 241, 0.93);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(33,31,28,0.08);
  }

  .nav-logo {
    font-family: 'Fraunces', serif;
    font-size: 18px;
    letter-spacing: 0.3px;
  }

  .nav-logo span { color: #C17154; }

  .nav-links {
    display: flex;
    gap: 34px;
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .nav-links a { opacity: 0.65; transition: opacity 0.25s; }
  .nav-links a:hover { opacity: 1; }

  .nav-cta {
    background: #211F1C;
    color: #FAF7F1 !important;
    padding: 10px 22px;
    border-radius: 2px;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    opacity: 1 !important;
  }

  @media (max-width: 780px) {
    .nav-links { display: none; }
  }

  /* ===== HERO ===== */
  .hero {
    min-height: 92vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 150px 6% 70px;
    background: linear-gradient(180deg, #F1E4D8 0%, #FAF7F1 70%);
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #C17154;
    margin-bottom: 20px;
  }

  .hero h1 {
    font-size: clamp(42px, 6.5vw, 72px);
    line-height: 1.05;
    margin-bottom: 24px;
  }

  .hero h1 em { font-style: italic; color: #6B7A5E; }

  .hero-sub {
    max-width: 500px;
    font-size: 16px;
    opacity: 0.72;
    margin-bottom: 36px;
  }

  .hero-buttons {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 40px;
  }

  .btn-primary {
    background: #211F1C;
    color: #FAF7F1;
    padding: 15px 32px;
    border-radius: 2px;
    font-size: 13px;
    letter-spacing: 1px;
    transition: transform 0.25s, background 0.25s;
    display: inline-block;
  }
  .btn-primary:hover { background: #C17154; transform: translateY(-2px); }

  .btn-secondary {
    border: 1px solid #211F1C;
    padding: 15px 32px;
    border-radius: 2px;
    font-size: 13px;
    letter-spacing: 1px;
    transition: all 0.25s;
    display: inline-block;
  }
  .btn-secondary:hover { background: #211F1C; color: #FAF7F1; }

  .rating-strip {
    font-size: 13px;
    letter-spacing: 0.3px;
    opacity: 0.6;
  }
  .rating-strip strong { color: #C17154; opacity: 1; }

  /* ===== SECTIONS ===== */
  .section {
    padding: 90px 6%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-label {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #C17154;
    text-align: center;
    margin-bottom: 12px;
  }

  .section-title {
    font-size: 36px;
    text-align: center;
    margin-bottom: 16px;
  }

  .section-title em { font-style: italic; color: #6B7A5E; }

  .section-intro {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 56px;
    opacity: 0.7;
    font-size: 15px;
  }

  /* ===== DIRECTORY — signature element ===== */
  .directory {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .suite-card {
    background: #F1E4D8;
    border-radius: 6px;
    padding: 32px 26px;
    position: relative;
  }

  .suite-num {
    position: absolute;
    top: 20px;
    right: 22px;
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 13px;
    color: #C17154;
  }

  .suite-card h3 {
    font-size: 21px;
    margin-bottom: 8px;
  }

  .suite-card .specialty {
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #6B7A5E;
    margin-bottom: 14px;
  }

  .suite-card p {
    font-size: 13.5px;
    opacity: 0.7;
  }

  @media (max-width: 860px) {
    .directory { grid-template-columns: 1fr; }
  }

  /* ===== ABOUT ===== */
  .about {
    background: #211F1C;
    color: #FAF7F1;
    padding: 100px 6%;
  }

  .about-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 70px;
    align-items: center;
  }

  .about-frame {
    aspect-ratio: 4/5;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: linear-gradient(160deg, rgba(193,113,84,0.2), rgba(107,122,94,0.15));
  }

  .about-frame span {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 15px;
    opacity: 0.55;
    text-align: center;
    padding: 0 20px;
  }

  .about-text .section-label { text-align: left; }

  .about-text h2 {
    font-size: 32px;
    margin-bottom: 22px;
    line-height: 1.2;
  }

  .about-text h2 em { font-style: italic; color: #C1A08D; }

  .about-text p {
    font-size: 15.5px;
    opacity: 0.75;
    margin-bottom: 16px;
    max-width: 480px;
  }

  @media (max-width: 800px) {
    .about-inner { grid-template-columns: 1fr; }
    .about-frame { max-width: 260px; margin: 0 auto; }
  }

  /* ===== REVIEWS ===== */
  .reviews-strip {
    background: #F1E4D8;
    padding: 90px 6%;
    text-align: center;
  }

  .stars {
    font-size: 22px;
    color: #C17154;
    letter-spacing: 4px;
    margin-bottom: 20px;
  }

  .reviews-strip h2 {
    font-size: 30px;
    max-width: 640px;
    margin: 0 auto 18px;
    line-height: 1.35;
    font-style: italic;
  }

  .reviews-strip .rating-line {
    font-size: 14px;
    opacity: 0.6;
    letter-spacing: 0.5px;
  }

  /* ===== CTA / CONTACT ===== */
  .cta {
    padding: 110px 6%;
    text-align: center;
  }

  .cta h2 {
    font-size: 38px;
    margin-bottom: 18px;
  }

  .cta h2 em { font-style: italic; color: #C17154; }

  .cta p {
    opacity: 0.7;
    max-width: 460px;
    margin: 0 auto 40px;
  }

  .contact-info {
    margin-top: 50px;
    display: flex;
    justify-content: center;
    gap: 60px;
    flex-wrap: wrap;
    font-size: 13.5px;
  }

  .contact-info div .label {
    display: block;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #C17154;
    margin-bottom: 6px;
  }

  footer {
    background: #211F1C;
    color: rgba(250,247,241,0.5);
    text-align: center;
    padding: 34px 6%;
    font-size: 12px;
    letter-spacing: 0.5px;
  }

  footer strong { color: #FAF7F1; }
</style>
</head>
<body>

  <nav class="nav">
    <div class="nav-logo">Salon <span>Idieh</span></div>
    <div class="nav-links">
      <a href="#directory">Our Stylists</a>
      <a href="#about">About</a>
      <a href="#reviews">Reviews</a>
    </div>
    <a href="#book" class="nav-cta">Find a Stylist</a>
  </nav>

  <section class="hero">
    <div class="eyebrow">Ellenwood, Georgia</div>
    <h1>One address.<br><em>Every</em> specialty.</h1>
    <p class="hero-sub">Salon Idieh is home to independent stylists under one roof — find the right suite for your next appointment.</p>
    <div class="hero-buttons">
      <a href="#directory" class="btn-primary">Browse Stylists</a>
      <a href="#book" class="btn-secondary">Get in Touch</a>
