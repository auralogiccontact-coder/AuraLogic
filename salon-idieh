  </section>

  <section class="about" id="about">
    <div class="about-inner">
      <div class="about-frame"><span>Photo of<br>Salon Idieh<br>suites</span></div>
      <div class="about-text">
        <div class="section-label">The Space</div>
        <h2>A beautiful, <em>simple</em> home for independent talent.</h2>
