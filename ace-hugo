<style>
  :root{
    --bg:#0a0908;
    --bg2:#141110;
    --paper:#f5efe0;
    --red:#c81d25;
    --red-dim:#7a1116;
    --gold:#d4a94c;
    --ink-dim:#948d7e;
    --line:#2a2622;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{background:var(--bg);color:var(--paper);font-family:'Space Mono',monospace;overflow-x:hidden;position:relative;}
  a{color:inherit;text-decoration:none;}
  h1,h2,h3,.display{font-family:'Anton',sans-serif;font-weight:400;text-transform:uppercase;letter-spacing:.01em;line-height:.9;}
  .wrap{max-width:1220px;margin:0 auto;padding:0 40px;}
  .eyebrow{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:700;}

  /* floating suit icons, ambient */
  .float-layer{position:fixed;inset:0;z-index:1;pointer-events:none;overflow:hidden;}
  .suit{position:absolute;bottom:-60px;font-size:22px;color:var(--red);opacity:.16;animation:rise linear infinite;}
  .suit.gold{color:var(--gold);}
  @keyframes rise{from{transform:translateY(0) rotate(0deg);}to{transform:translateY(-115vh) rotate(25deg);}}
  @media (prefers-reduced-motion: reduce){.suit{animation:none;display:none;}}

  /* marquee ticker */
  .ticker{background:var(--red);color:var(--paper);overflow:hidden;white-space:nowrap;border-bottom:1px solid var(--line);position:relative;z-index:50;}
  .ticker-track{display:inline-block;padding:9px 0;animation:tick 22s linear infinite;font-size:11px;letter-spacing:.16em;text-transform:uppercase;font-weight:700;}
  .ticker-track span{margin:0 28px;}
  @keyframes tick{from{transform:translateX(0);}to{transform:translateX(-50%);}}
  @media (prefers-reduced-motion: reduce){.ticker-track{animation:none;}}

  nav{position:sticky;top:0;z-index:100;background:rgba(10,9,8,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);}
  .nav-inner{max-width:1220px;margin:0 auto;padding:22px 40px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;}
  .nav-links{display:flex;gap:30px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-dim);}
  .nav-links.right{justify-content:flex-end;}
  .nav-links a:hover{color:var(--gold);}
  .logo{font-family:'Anton',sans-serif;font-size:24px;letter-spacing:.03em;text-align:center;}
  .logo .ace{color:var(--red);}
  @media(max-width:800px){.nav-links{display:none;}.nav-inner{grid-template-columns:1fr;}}

  /* HERO — mic + speakers behind name, pulsing sound */
  .hero{position:relative;min-height:96vh;display:flex;align-items:center;justify-content:center;overflow:hidden;border-bottom:1px solid var(--line);text-align:center;}
  .hero-bg{position:absolute;inset:0;z-index:0;background:radial-gradient(ellipse at 50% 45%, #1a1512, var(--bg) 72%);}
  .rig{position:absolute;inset:0;z-index:1;display:flex;align-items:center;justify-content:center;opacity:.9;}
  .rig svg{width:min(1400px,150vw);height:auto;}
  .speaker-cone{transform-origin:center;animation:thump 1.1s ease-in-out infinite;}
  .speaker-cone.b{animation-delay:.15s;}
  @keyframes thump{0%,100%{transform:scale(1);}50%{transform:scale(1.09);}}
  .wave{transform-origin:center;animation:wave-out 2.4s ease-out infinite;opacity:0;}
  .wave.d1{animation-delay:0s;}
  .wave.d2{animation-delay:.8s;}
  .wave.d3{animation-delay:1.6s;}
  @keyframes wave-out{0%{opacity:.55;transform:scale(.6);}100%{opacity:0;transform:scale(1.5);}}
  @media (prefers-reduced-motion: reduce){.speaker-cone,.wave{animation:none;}}

  .hero-content{position:relative;z-index:2;}
  .hero-tag{display:block;margin-bottom:18px;}
  .hero h1{font-size:clamp(64px,15vw,220px);color:var(--paper);text-shadow:0 0 60px rgba(0,0,0,.6);}
  .hero h1 .ace{color:var(--red);}
  .hero-sub{max-width:520px;margin:22px auto 0;color:var(--ink-dim);font-size:13px;line-height:1.8;}
  .hero-cta{margin-top:34px;display:inline-flex;gap:16px;flex-wrap:wrap;justify-content:center;}
  .btn-solid{background:var(--red);color:var(--paper);padding:15px 32px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;}
  .btn-outline{border:1px solid var(--gold);color:var(--gold);padding:15px 32px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;}

  /* equalizer strip */
  .eq{display:flex;align-items:flex-end;gap:4px;height:28px;justify-content:center;margin-top:36px;}
  .eq span{width:4px;background:var(--gold);animation:eqbar 1s ease-in-out infinite;}
  .eq span:nth-child(1){animation-delay:0s;} .eq span:nth-child(2){animation-delay:.1s;}
  .eq span:nth-child(3){animation-delay:.2s;} .eq span:nth-child(4){animation-delay:.3s;}
  .eq span:nth-child(5){animation-delay:.15s;} .eq span:nth-child(6){animation-delay:.25s;}
  .eq span:nth-child(7){animation-delay:.05s;}
  @keyframes eqbar{0%,100%{height:6px;}50%{height:28px;}}
  @media (prefers-reduced-motion: reduce){.eq span{animation:none;height:16px;}}

  .section{padding:100px 0;border-bottom:1px solid var(--line);position:relative;z-index:2;background:var(--bg);}
  .section-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:48px;flex-wrap:wrap;gap:12px;}
  .section-head h2{font-size:clamp(36px,6vw,64px);color:var(--paper);}
  .section-num{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-dim);}

  /* TRACKS */
  .track-row{
    display:grid;grid-template-columns:50px 1fr auto auto;gap:20px;align-items:center;
    padding:20px 0;border-top:1px solid var(--line);transition:.2s;
  }
  .tracks .track-row:last-child{border-bottom:1px solid var(--line);}
  .track-row:hover{background:var(--bg2);}
  .track-row .tn{font-family:'Anton',sans-serif;font-size:20px;color:var(--red);}
  .track-row .tt{font-size:15px;color:var(--paper);}
  .track-row .tf{font-size:11px;color:var(--ink-dim);display:block;margin-top:3px;}
  .track-row .len{font-size:12px;color:var(--ink-dim);}
  .mini-eq{display:flex;align-items:flex-end;gap:2px;height:16px;}
  .mini-eq span{width:2px;background:var(--gold);animation:eqbar .9s ease-in-out infinite;opacity:.7;}
  .mini-eq span:nth-child(2){animation-delay:.15s;} .mini-eq span:nth-child(3){animation-delay:.3s;}

  /* TOUR — train track */
  .tour-scroll{overflow-x:auto;padding-bottom:20px;}
  .track-rail{position:relative;min-width:1400px;height:230px;}
  .rail-svg{position:absolute;top:96px;left:0;width:100%;height:60px;}
  .rail-line{stroke:var(--line);stroke-width:6;fill:none;stroke-dasharray:2 14;stroke-linecap:round;}
  .train{
    position:absolute;top:70px;width:64px;height:64px;
    offset-path:path("M 10 30 L 1390 30");
    animation:choo 16s linear infinite;
  }
  @keyframes choo{from{offset-distance:0%;}to{offset-distance:100%;}}
  @media (prefers-reduced-motion: reduce){.train{animation:none;offset-distance:0%;}}
  .stops{position:relative;display:flex;justify-content:space-between;min-width:1400px;padding-top:150px;}
  .stop{width:140px;text-align:center;}
  .stop .dot{width:14px;height:14px;border-radius:50%;background:var(--gold);margin:0 auto 14px;border:3px solid var(--bg);box-shadow:0 0 0 2px var(--gold);position:relative;top:-155px;}
  .stop .city{font-family:'Anton',sans-serif;font-size:16px;color:var(--paper);margin-top:-140px;}
  .stop .date{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-top:4px;}
  .stop .venue{font-size:10px;color:var(--ink-dim);margin-top:4px;}

  /* STORE */
  .merch-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1px;background:var(--line);}
  .product{background:var(--bg);padding:26px;display:flex;flex-direction:column;gap:12px;}
  .product-img{aspect-ratio:4/3;background:linear-gradient(160deg,var(--bg2),var(--bg));border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-family:'Anton',sans-serif;font-size:13px;letter-spacing:.1em;color:var(--gold);}
  .pn{font-size:14px;color:var(--paper);}
  .pd{font-size:11px;color:var(--ink-dim);}
  .pp{display:flex;justify-content:space-between;align-items:center;margin-top:4px;}
  .price{font-size:14px;color:var(--red);}
  .addbtn{background:none;border:1px solid var(--line);color:var(--paper);padding:8px 16px;font-size:10px;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;font-family:inherit;transition:.2s;}
  .addbtn:hover{border-color:var(--gold);color:var(--gold);}

  /* social icon strip - moving */
  .social-strip{display:flex;justify-content:center;gap:26px;padding:40px 0;}
  .social-strip a{width:42px;height:42px;border:1px solid var(--line);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--ink-dim);transition:.25s;}
  .social-strip a:hover{border-color:var(--red);color:var(--red);transform:translateY(-4px);}

  footer{padding:80px 0 32px;position:relative;z-index:2;background:var(--bg);}
  .footer-top h3{font-size:clamp(28px,5vw,44px);color:var(--paper);margin-bottom:24px;}
  .foot-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;margin:56px 0 40px;padding-top:32px;border-top:1px solid var(--line);}
  .foot-col span.eyebrow{display:block;margin-bottom:12px;}
  .foot-col a{display:block;font-size:13px;color:var(--paper);margin-bottom:8px;}
  .foot-col a:hover{color:var(--gold);}
  .foot-col p{font-size:12px;color:var(--ink-dim);}
  .footer-bottom{display:flex;justify-content:space-between;font-size:11px;color:var(--ink-dim);flex-wrap:wrap;gap:8px;}
  @media(max-width:820px){.foot-grid{grid-template-columns:1fr 1fr;}}

  :focus-visible{outline:2px solid var(--gold);outline-offset:3px;}
</style>
</head>
