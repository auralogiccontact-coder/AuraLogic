<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Suites Nails Salon — College Park, GA</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@400;500;600;700&family=Jost:wght@200;300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --black:#0D0D0C;
    --charcoal:#1C1A16;
    --gold:#C9A227;
    --gold-bright:#F0C869;
    --gold-deep:#8A6B1F;
    --white:#F0EDE6;
    --gray:#9B9488;
    --line: rgba(201,162,39,0.24);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--black);
    color:var(--white);
    font-family:'Jost',sans-serif;
    font-weight:300;
  }
  .script{font-family:'Alex Brush',cursive; font-weight:400;}
  .display{font-family:'Cinzel',serif; font-weight:600;}
  a{color:inherit; text-decoration:none;}

  .reveal{opacity:0; transform:translateY(16px); transition:opacity 0.8s ease, transform 0.8s ease;}
  .reveal.in{opacity:1; transform:none;}
  @media (prefers-reduced-motion: reduce){ .reveal{opacity:1; transform:none;} html{scroll-behavior:auto;} }

  /* textured diagonal background, echoing the flyer */
  .texture{
    position:absolute; inset:0;
    background-image: repeating-linear-gradient(135deg, rgba(255,255,255,0.02) 0px, rgba(255,255,255,0.02) 1px, transparent 1px, transparent 26px);
    pointer-events:none;
  }

  nav{
    position:fixed; top:0; left:0; right:0; z-index:50;
    display:flex; align-items:center; justify-content:space-between;
    padding:22px 6vw;
    background:rgba(13,13,12,0);
    transition:background 0.4s ease, box-shadow 0.4s ease;
  }
  nav.scrolled{ background:rgba(13,13,12,0.95); backdrop-filter:blur(6px); box-shadow:0 2px 18px rgba(0,0,0,0.4); }
  nav .nav-mark{ font-family:'Alex Brush',cursive; font-size:1.5rem; color:var(--gold-bright); }
  nav ul{ list-style:none; display:flex; gap:32px; font-size:0.68rem; text-transform:uppercase; letter-spacing:0.18em; color:var(--white); }
  nav a:focus-visible, button:focus-visible{ outline:2px solid var(--gold); outline-offset:4px; }
  @media (max-width:820px){ nav ul{display:none;} }

  .hero{
    position:relative;
    z-index:0;
    overflow:hidden;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(201,162,39,0.14) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 75%, rgba(201,162,39,0.08) 0%, transparent 55%),
      var(--black);
    min-height:100svh;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center;
    padding:150px 6vw 90px;
  }
  .moon-wrap{ position:relative; width:min(320px, 60vw); margin:0 auto 8px; }
  .sparkle{ position:absolute; color:var(--gold-bright); }
  .hero-eyebrow{
    font-size:0.7rem; letter-spacing:0.36em; text-transform:uppercase;
    color:var(--gold); margin-bottom:6px; position:relative; font-weight:500;
  }
  .hero h1{
    color:var(--gold-bright);
    font-size:clamp(4rem, 12vw, 8.5rem);
    line-height:1;
    text-shadow:0 4px 24px rgba(201,162,39,0.35);
    position:relative;
  }
  .hero .subtitle{
    margin-top:-6px;
    font-size:1rem;
    letter-spacing:0.5em;
    text-transform:uppercase;
    color:var(--white);
    font-family:'Cinzel',serif;
    font-weight:500;
    position:relative;
  }
  .hero .tagline{
    margin-top:26px;
    font-size:1.05rem;
    color:var(--gray);
    font-style:italic;
    position:relative;
  }
  .stat-row{
    position:relative;
    margin-top:42px;
    display:flex; gap:0; justify-content:center; flex-wrap:wrap;
  }
  .stat{ text-align:center; padding:0 30px; border-left:1px solid var(--line); }
  .stat:first-child{ border-left:none; }
  .stat .num{ font-family:'Cinzel',serif; font-weight:600; font-size:1.5rem; color:var(--gold-bright); }
  .stat .lbl{ font-size:0.6rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--gray); margin-top:4px; }

  .cta{
    display:inline-block;
    margin-top:44px;
    padding:16px 42px;
    background:linear-gradient(135deg, var(--gold-bright), var(--gold));
    color:var(--black);
    font-family:'Cinzel',serif;
    font-weight:600;
    font-size:0.8rem;
    letter-spacing:0.1em;
    text-transform:uppercase;
    border-radius:999px;
    box-shadow:0 10px 28px rgba(201,162,39,0.3);
    transition:transform 0.3s ease, box-shadow 0.3s ease;
  }
  .cta:hover{ transform:translateY(-2px); box-shadow:0 14px 32px rgba(201,162,39,0.4); }
  .cta.outline{ background:transparent; color:var(--gold-bright); border:1px solid var(--gold); box-shadow:none; }
  .cta.outline:hover{ background:var(--gold); color:var(--black); }

  section{ padding:100px 6vw; position:relative; }
  .section-head{ max-width:600px; margin:0 auto 54px; text-align:center; }
  .section-eyebrow{ font-size:0.68rem; letter-spacing:0.3em; text-transform:uppercase; color:var(--gold); margin-bottom:14px; font-weight:500; }
  .section-head h2{ font-family:'Cinzel',serif; font-weight:600; font-size:clamp(1.8rem,3.6vw,2.5rem); color:var(--gold-bright); }

  .services-grid{
    max-width:1000px; margin:0 auto;
    display:grid; grid-template-columns:repeat(4,1fr); gap:1px;
    background:var(--line);
  }
  .service-card{ background:var(--charcoal); padding:40px 20px; text-align:center; }
  .service-card .ring{
    width:52px; height:52px; margin:0 auto 16px;
    border-radius:50%; border:1px solid var(--gold);
    display:flex; align-items:center; justify-content:center;
    font-family:'Cinzel',serif; font-weight:600; color:var(--gold-bright); font-size:0.85rem;
  }
  .service-card h3{ font-family:'Cinzel',serif; font-weight:600; font-size:1rem; margin-bottom:8px; color:var(--white); }
  .service-card p{ font-size:0.8rem; line-height:1.55; color:var(--gray); font-weight:300; }
  @media (max-width:820px){ .services-grid{ grid-template-columns:repeat(2,1fr); } }
  @media (max-width:560px){ .services-grid{ grid-template-columns:1fr; } }
  .services-footnote{ text-align:center; margin-top:40px; font-size:0.85rem; color:var(--gray); font-style:italic; }

  .about{ background:var(--charcoal); }
  .about-grid{ max-width:960px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center; }
  .about h2{ font-family:'Cinzel',serif; font-weight:600; font-size:clamp(1.7rem,3.6vw,2.2rem); margin-bottom:22px; text-align:left; color:var(--gold-bright); }
  .about p{ font-size:0.96rem; line-height:1.9; color:#C9C3B8; font-weight:300; }
  .about p + p{ margin-top:16px; }
  .badge-row{ display:flex; gap:0; flex-wrap:wrap; margin-top:28px; border-top:1px solid var(--line); }
  .badge{ padding:14px 20px 14px 0; font-size:0.7rem; letter-spacing:0.06em; text-transform:uppercase; color:var(--gold-bright); font-weight:600; }
  .about-quote{ border-left:2px solid var(--gold); padding-left:28px; }
  .about-quote p{ font-family:'Cinzel',serif; font-weight:500; font-size:1.05rem; line-height:1.6; color:var(--white); }
  .about-quote span{ display:block; margin-top:16px; font-size:0.68rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--gray); }
  @media (max-width:820px){ .about-grid{ grid-template-columns:1fr; gap:40px; } .about-quote{ order:2; } }

  .visit{ background:var(--black); }
  .visit-grid{ max-width:900px; margin:0 auto; display:grid; grid-template-columns:1.1fr 0.9fr; gap:56px; }
  .visit h2{ font-family:'Cinzel',serif; font-weight:600; font-size:clamp(1.7rem,3.6vw,2.2rem); margin-bottom:20px; color:var(--gold-bright); }
  .visit p{ font-size:0.94rem; line-height:1.8; color:#C9C3B8; font-weight:300; }
  .visit-label{ font-size:0.64rem; letter-spacing:0.22em; text-transform:uppercase; color:var(--gold); margin-bottom:14px; display:block; font-weight:500; }
  .hours-table{ width:100%; border-collapse:collapse; font-size:0.88rem; }
  .hours-table td{ padding:10px 0; border-bottom:1px solid var(--line); color:#C9C3B8; font-weight:300; }
  .hours-table tr:first-child td{ border-top:1px solid var(--line); }
  .hours-table td:last-child{ text-align:right; font-family:'Cinzel',serif; color:var(--gold-bright); font-size:0.92rem; }
  .visit .cta{ margin-top:28px; }
  .visit-note{ margin-top:22px; font-size:0.82rem; color:var(--gray); font-style:italic; }
  @media (max-width:820px){ .visit-grid{ grid-template-columns:1fr; gap:40px; } }

  footer{
    max-width:900px; margin:60px auto 0; padding:26px 6vw 30px;
    border-top:1px solid var(--line);
    display:flex; justify-content:space-between; align-items:center;
    font-size:0.68rem; letter-spacing:0.08em; color:var(--gray); text-transform:uppercase;
  }
  footer a{ border-bottom:1px solid var(--gold); padding-bottom:2px; color:var(--gold-bright); }
  footer a:hover{ color:var(--white); }
  @media (max-width:640px){ footer{ flex-direction:column; gap:12px; text-align:center; } }
</style>
</head>
<body>

<nav id="siteNav">
  <div class="nav-mark">Suites</div>
  <ul>
    <li><a href="#services">Services</a></li>
    <li><a href="#about">About</a></li>
    <li><a href="#visit">Visit</a></li>
  </ul>
</nav>

<header class="hero">
  <div class="texture"></div>
  <div class="moon-wrap reveal">
    <svg viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="moonGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#F0C869"/>
          <stop offset="100%" stop-color="#8A6B1F"/>
        </linearGradient>
      </defs>
      <!-- crescent moon -->
      <path d="M170,20 A80,80 0 1 0 170,180 A64,80 0 1 1 170,20 Z" fill="url(#moonGrad)"/>
      <!-- small stars/sparkles -->
      <g fill="#F0C869">
        <path d="M235,35 l3,8 l8,3 l-8,3 l-3,8 l-3,-8 l-8,-3 l8,-3 Z"/>
        <path d="M260,65 l2,5 l5,2 l-5,2 l-2,5 l-2,-5 l-5,-2 l5,-2 Z"/>
        <path d="M215,155 l2.5,6 l6,2.5 l-6,2.5 l-2.5,6 l-2.5,-6 l-6,-2.5 l6,-2.5 Z"/>
        <circle cx="245" cy="100" r="2"/>
        <circle cx="270" cy="40" r="1.6"/>
      </g>
    </svg>
  </div>
  <div class="hero-eyebrow">College Park, Georgia</div>
  <h1 class="script">Suites</h1>
  <div class="subtitle">Nails Salon</div>
  <div class="tagline">Walk-Ins Welcome</div>

  <div class="stat-row">
    <div class="stat"><div class="num">4.9</div><div class="lbl">333 Reviews</div></div>
    <div class="stat"><div class="num">7</div><div class="lbl">Days A Week</div></div>
    <div class="stat"><div class="num">ATL</div><div class="lbl">College Park</div></div>
  </div>

  <a href="tel:+14049637244" class="cta">Call Now</a>
</header>

<section id="services">
  <div class="section-head reveal">
    <div class="section-eyebrow">The Menu</div>
    <h2>Luxury, Every Visit</h2>
  </div>
  <div class="services-grid">
    <div class="service-card reveal">
      <div class="ring">MP</div>
      <h3>Mani &amp; Pedi</h3>
      <p>Classic and gel, for both ladies and gentlemen.</p>
    </div>
    <div class="service-card reveal">
      <div class="ring">SNS</div>
      <h3>SNS &amp; Dip</h3>
      <p>Long-lasting powder color, healthy and durable.</p>
    </div>
    <div class="service-card reveal">
      <div class="ring">SP</div>
      <h3>Spa Pedicure</h3>
      <p>A relaxing, elevated pedicure experience.</p>
    </div>
    <div class="service-card reveal">
      <div class="ring">BR</div>
      <h3>Brow Waxing</h3>
      <p>Clean shaping to complete your visit.</p>
    </div>
  </div>
  <div class="services-footnote reveal">Luxury packages available &middot; full pricing shared in-salon.</div>
</section>

<section id="about" class="about">
  <div class="about-grid">
    <div class="reveal">
      <div class="section-eyebrow">The Salon</div>
      <h2>A College Park Gem</h2>
      <p>Suites Nails Salon is a 4.9-star nail studio in College Park, known for a clean space, genuine hospitality, and techs who take their time. Regulars ask for Bryan and Ryan by name — both known for detailed work and a real sense of care for every client.</p>
      <p>Walk-ins are always welcome, and the team makes sure every guest feels taken care of from the moment they sit down.</p>
      <div class="badge-row">
        <span class="badge">4.9 Stars &middot; 333 Reviews</span>
        <span class="badge">Walk-Ins Welcome</span>
        <span class="badge">College Park, GA</span>
      </div>
    </div>
    <div class="about-quote reveal">
      <p>Bryan and Ryan did an amazing job on me and my wife's nails and toes. They took their time and really showed they cared about their work.</p>
      <span>Google Review</span>
    </div>
  </div>
</section>

<section id="visit" class="visit">
  <div class="visit-grid">
    <div class="reveal">
      <span class="visit-label">Visit</span>
      <h2>Come Get Pampered</h2>
      <p>5495 Old National Hwy<br>Suite A5<br>College Park, GA 30349</p>
      <p style="margin-top:14px;">(404) 963-7244</p>
      <a href="tel:+14049637244" class="cta">Call Now</a>
      <div class="visit-note">Walk-ins welcome — call ahead to check availability.</div>
    </div>
    <div class="reveal">
      <span class="visit-label">Hours</span>
      <table class="hours-table">
        <tr><td>Monday</td><td>10am – 8pm</td></tr>
        <tr><td>Tuesday</td><td>10am – 8pm</td></tr>
        <tr><td>Wednesday</td><td>10am – 8pm</td></tr>
        <tr><td>Thursday</td><td>10am – 8pm</td></tr>
        <tr><td>Friday</td><td>9am – 8pm</td></tr>
        <tr><td>Saturday</td><td>9am – 8pm</td></tr>
        <tr><td>Sunday</td><td>11am – 6pm</td></tr>
      </table>
    </div>
  </div>
  <footer>
    <div>&copy; Suites Nails Salon, College Park GA</div>
    <a href="tel:+14049637244">(404) 963-7244</a>
  </footer>
</section>

<script>
  const nav = document.getElementById('siteNav');
  window.addEventListener('scroll', ()=>{
    if(window.scrollY > 60){ nav.classList.add('scrolled'); } else { nav.classList.remove('scrolled'); }
  });
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  }, {threshold:0.15});
  document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
</script>

</body>
</html>
