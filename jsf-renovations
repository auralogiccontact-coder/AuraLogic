    font-size: 13px;
    color: #B89968;
  }
  .menu-name {
    font-family: 'Bodoni Moda', serif;
    font-size: 28px;
    font-style: italic;
    font-weight: 500;
  }
  .menu-desc {
    font-size: 14.5px;
    color: #A99485;
    margin-top: 8px;
    max-width: 460px;
    font-style: normal;
  }
  .menu-cta-col {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #C97B84;
    white-space: nowrap;
  }

  /* ---------- Why-owned-site ---------- */
  .why {
    background: #33202A;
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(184, 153, 104, 0.22);
    border: 1px solid rgba(184, 153, 104, 0.22);
  }
  @media (max-width: 780px) { .why-grid { grid-template-columns: 1fr; } }
  .why-card {
    background: #33202A;
    padding: 44px 36px;
  }
  .why-num {
    font-family: 'Bodoni Moda', serif;
    font-style: italic;
    font-size: 40px;
    color: #C97B84;
    margin-bottom: 18px;
  }
  .why-card h3 {
    font-family: 'Bodoni Moda', serif;
    font-weight: 500;
    font-size: 21px;
    margin-bottom: 12px;
  }
  .why-card p { font-size: 14.5px; color: #B8A79A; }

  /* ---------- Booking CTA ---------- */
  .book {
    text-align: center;
  }
  .book h2 {
    font-family: 'Bodoni Moda', serif;
    font-size: clamp(38px, 6vw, 72px);
