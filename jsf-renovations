<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lush Lashes by Lexi | Macon, GA Lash Extensions</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400;1,6..96,500&family=Work+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: #1F1714;
    color: #F5EDE4;
    font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-weight: 300;
    line-height: 1.6;
    overflow-x: hidden;
  }

  ::selection { background: #C97B84; color: #1F1714; }

  a { color: inherit; text-decoration: none; }

  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ---------- Lash line signature element ---------- */
  .lashline {
    width: 100%;
    height: 46px;
    display: block;
  }
  .lashline path {
    stroke: #B89968;
    stroke-width: 1.6;
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 160;
    stroke-dashoffset: 160;
    animation: draw 1.6s ease forwards;
  }
  .lashline.rose path { stroke: #C97B84; }
  .lashline path:nth-child(1) { animation-delay: 0.05s; }
  .lashline path:nth-child(2) { animation-delay: 0.12s; }
  .lashline path:nth-child(3) { animation-delay: 0.19s; }
  .lashline path:nth-child(4) { animation-delay: 0.26s; }
  .lashline path:nth-child(5) { animation-delay: 0.33s; }
  .lashline path:nth-child(6) { animation-delay: 0.40s; }
  .lashline path:nth-child(7) { animation-delay: 0.47s; }
  .lashline path:nth-child(8) { animation-delay: 0.54s; }
  .lashline path:nth-child(9) { animation-delay: 0.61s; }
  .lashline path:nth-child(10) { animation-delay: 0.68s; }
  .lashline path:nth-child(11) { animation-delay: 0.75s; }
  .lashline path:nth-child(12) { animation-delay: 0.82s; }

  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lashline path { animation: none; stroke-dashoffset: 0; }
  }

  /* ---------- Nav ---------- */
  header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: rgba(31, 23, 20, 0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(184, 153, 104, 0.18);
  }
  nav {
    max-width: 1180px;
    margin: 0 auto;
    padding: 18px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brandmark {
    font-family: 'Bodoni Moda', serif;
    font-size: 19px;
    letter-spacing: 0.02em;
  }
  .brandmark em { font-style: italic; color: #C97B84; }
  .navlinks {
    display: flex;
    gap: 36px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #D9C9BC;
  }
  .navlinks a { transition: color 0.2s; }
  .navlinks a:hover { color: #C97B84; }
  .nav-cta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid #B89968;
    color: #B89968;
    padding: 9px 18px;
    transition: all 0.25s;
  }
  .nav-cta:hover { background: #B89968; color: #1F1714; }
  @media (max-width: 760px) { .navlinks { display: none; } }

  /* ---------- Hero ---------- */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 90px;
    position: relative;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: 0; right: -10%;
    width: 55%;
    height: 100%;
    background: radial-gradient(ellipse at center, rgba(201, 123, 132, 0.10) 0%, transparent 70%);
    pointer-events: none;
  }
  .eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #B89968;
    margin-bottom: 28px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: #B89968;
  }
  h1 {
    font-family: 'Bodoni Moda', serif;
    font-weight: 400;
    font-size: clamp(56px, 9vw, 128px);
    line-height: 0.95;
    letter-spacing: -0.01em;
    max-width: 950px;
  }
  h1 .italic {
    font-style: italic;
    font-weight: 500;
    color: #C97B84;
  }
  .hero-sub {
    max-width: 480px;
    margin-top: 32px;
    font-size: 18px;
    color: #D9C9BC;
    font-weight: 300;
  }
  .hero-actions {
    margin-top: 44px;
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .btn-primary {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: #C97B84;
    color: #1F1714;
    padding: 17px 34px;
    display: inline-block;
    transition: transform 0.25s ease, background 0.25s ease;
  }
  .btn-primary:hover { background: #E0A0A7; transform: translateY(-2px); }
  .hero-meta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    color: #A99485;
    letter-spacing: 0.03em;
  }

  .hero-lashline-holder { margin-top: 64px; max-width: 620px; }

  /* ---------- Section shared ---------- */
  section { padding: 120px 0; position: relative; }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 64px;
    gap: 24px;
    flex-wrap: wrap;
  }
  .section-title {
    font-family: 'Bodoni Moda', serif;
    font-size: clamp(36px, 5vw, 58px);
    font-weight: 400;
    line-height: 1.05;
  }
  .section-title .italic { font-style: italic; color: #C97B84; }
  .section-note {
    max-width: 320px;
    font-size: 15px;
    color: #A99485;
  }

  /* ---------- About / area ---------- */
  .about {
    background: #241A17;
    border-top: 1px solid rgba(184, 153, 104, 0.14);
    border-bottom: 1px solid rgba(184, 153, 104, 0.14);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 80px;
    align-items: center;
  }
  @media (max-width: 860px) { .about-grid { grid-template-columns: 1fr; gap: 48px; } }
  .about-text p {
    font-size: 17px;
    color: #D9C9BC;
    max-width: 480px;
    margin-bottom: 20px;
  }
  .about-text p:last-child { margin-bottom: 0; }
  .locator {
    border: 1px solid rgba(184, 153, 104, 0.35);
    padding: 40px;
  }
  .locator-row {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid rgba(184, 153, 104, 0.18);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
  }
  .locator-row:last-child { border-bottom: none; }
  .locator-row span:first-child { color: #A99485; text-transform: uppercase; letter-spacing: 0.06em; }
  .locator-row span:last-child { color: #F5EDE4; text-align: right; }

  /* ---------- Menu ---------- */
  .menu-list { border-top: 1px solid rgba(184, 153, 104, 0.22); }
  .menu-item {
    display: grid;
    grid-template-columns: 90px 1fr auto;
    align-items: baseline;
    gap: 24px;
    padding: 32px 0;
