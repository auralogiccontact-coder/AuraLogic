  .book h2 .italic { font-style: italic; color: #C97B84; }
  .book p { color: #A99485; max-width: 460px; margin: 0 auto 40px; }
  .book-cta-row { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; }
  .btn-outline {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid #B89968;
    color: #B89968;
    padding: 16px 32px;
    transition: all 0.25s;
  }
  .btn-outline:hover { background: #B89968; color: #1F1714; }

  /* ---------- Footer ---------- */
  footer {
    border-top: 1px solid rgba(184, 153, 104, 0.18);
    padding: 48px 0;
  }
  .foot-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .foot-brand {
    font-family: 'Bodoni Moda', serif;
    font-style: italic;
    font-size: 18px;
  }
  .foot-links {
    display: flex;
    gap: 28px;
    font-family: 'IBM Plex Mono', monospace;
